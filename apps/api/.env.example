NODE_ENV=development
PORT=3000
# Local development only. Do not reuse these credentials in a hosted environment.
DATABASE_URL=postgresql://dayjoin_app:local_app_only@localhost:15432/dayjoin
MIGRATION_DATABASE_URL=postgresql://dayjoin_migrator:local_migration_only@localhost:15432/dayjoin
REDIS_ENABLED=false
REDIS_URL=redis://localhost:16379

APP_URL=http://127.0.0.1:5173
MAIL_FROM=hello@dayjoin.test
# Without SMTP_URL, development writes private .eml files in apps/api/var/mail.
# Production requires HTTPS APP_URL and an actual SMTP provider.
# SMTP_URL=smtps://user:password@smtp.example.com:465
